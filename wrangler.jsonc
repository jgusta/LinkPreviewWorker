{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ogp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "ogp-worker.crazywall.cc",
      "custom_domain": true
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/preview", "/health"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://crazywall.cc,https://ogp-worker.crazywall.cc,http://localhost",
    "FETCH_TIMEOUT_MS": "10000",
    "MAX_HTML_BYTES": "1048576",
    "MAX_ASSET_BYTES": "20971520"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
